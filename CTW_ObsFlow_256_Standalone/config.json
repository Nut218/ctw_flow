{
  "data": "example/cave.mat",
  "srf": "example/srf_est.mat",
  "model_dir": "artifacts",
  "initial_factors": "artifacts/shared_initial_factors.pt",
  "out_dir": "outputs/example_run",
  "device": "auto",
  "seed": 0,
  "scale": 4,
  "ring_ranks": "12,12,12",
  "core_ranks": "3,3,3",
  "sampler": "flow",
  "flow": {
    "flow_checkpoint": "artifacts/flow_obscond_jointloss_light.pt",
    "flow_steps": 20,
    "flow_start": 0.85
  },
  "init_projection_steps": 100,
  "block_size": 16,
  "lambda_msi": 1.0,
  "projection_lr": 0.002,
  "factor_lr": 0.002,
  "factor_interval": 2,
  "factor_start_t": 400,
  "factor_anchor": 0.001,
  "final_factor_steps": 200,
  "final_joint_steps": 300,
  "rho_core": 0.01,
  "rho_decay": 0.998,
  "normalize_guidance": true,
  "coarse_to_fine_guidance": {"enabled": false},
  "joint_core_g3": {
    "enabled": true,
    "rho_g3": 0.00005,
    "g3_anchor": 0.1,
    "g3_max_relative_change": 0.25,
    "core_prior_weight": 0.1,
    "g3_prior_weight": 0.1,
    "g2_gate_enabled": true,
    "g2_gate_dim": 16,
    "g2_gate_steps": 50,
    "g2_gate_anchor": 0.1,
    "g2_gate_scales": "0,0.25,0.5,0.75,1",
    "g2_gate_holdout_period": 20
  },
  "cross_attention": {
    "d_model": 64,
    "num_heads": 4,
    "tokens_per_factor": 4,
    "interaction_tokens": true,
    "adapter_tta": false,
    "gate_init": 0.0
  }
}
